# STIXIN Daily Meeting Environment Variables

# Application Port (Default 8000)
PORT=8000

# 100% Free Supabase Cloud PostgreSQL Database (https://supabase.com)
# Example Supabase URI: postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# If left blank, the app automatically defaults to local persistent SQLite (./stixin.db) for $0.00
DATABASE_URL=

# Optional: Google Gemini Free API Key (Get at https://aistudio.google.com)
GEMINI_API_KEY=

# Optional: Groq Free API Key (Get at https://console.groq.com)
GROQ_API_KEY=
